# SPDX-License-Identifier: Apache-2.0
HTTP_ADDR=:8080
# Branchy's own tables live in a `branchy` schema and reference a shared `core`
# schema (core.person/core.chat, upserted via core.touch). `docker compose` runs
# a bundled Postgres, seeds a minimal `core` schema (deploy/core-init.sql), and
# adds `options=-csearch_path%3Dbranchy` to this URL. Against a shared or
# standalone database, append `?options=-csearch_path%3Dbranchy` (in production
# this points at the shared core-postgres).
DATABASE_URL=postgres://branchy:branchy@localhost:5432/branchy?sslmode=disable
MIGRATIONS_DIR=migrations
AUTO_MIGRATE=true
# Must be an HTTPS URL (GitHub OAuth and webhooks require it). In local
# development this is your tunnel URL; in production it is the public URL of a
# TLS-terminating proxy in front of HTTP_ADDR.
PUBLIC_BASE_URL=https://example-tunnel.ngrok-free.app

TELEGRAM_BOT_TOKEN=CHANGE_ME

GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_OAUTH_SCOPE=repo read:user
GITHUB_WEBHOOK_SECRET=CHANGE_ME

# Used to encrypt OAuth access tokens at rest. Set a long random value of at
# least 32 characters (e.g. `openssl rand -base64 48`). The placeholder below
# is intentionally too short so an unedited copy fails startup validation.
APP_SECRET=CHANGE_ME

# Outbox tuning (optional). Defaults shown; durations use Go syntax (e.g. 2s,
# 1m30s). Malformed or non-positive values fail startup.
# OUTBOX_POLL_INTERVAL=2s
# OUTBOX_BATCH_SIZE=20
# OUTBOX_SEND_TIMEOUT=20s
# OUTBOX_LEASE=2m
# OUTBOX_RETENTION_DAYS=7
# NOTIFICATION_MAX_ATTEMPTS=5
