# SPDX-License-Identifier: Apache-2.0
HTTP_ADDR=:8080
DATABASE_URL=postgres://branchy:branchy@localhost:5432/branchy?sslmode=disable
MIGRATIONS_DIR=migrations
AUTO_MIGRATE=true
PUBLIC_BASE_URL=https://example-tunnel.ngrok-free.app

TELEGRAM_BOT_TOKEN=123456:replace-me

GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_OAUTH_SCOPE=repo read:user
GITHUB_WEBHOOK_SECRET=replace-with-random-string

# Used to encrypt OAuth access tokens at rest. Set a long random value.
APP_SECRET=replace-with-at-least-32-random-characters
